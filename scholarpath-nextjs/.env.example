# Copy to `.env.local` (Git ignores it). Only NEXT_PUBLIC_* variables are exposed to the browser,
# so never put database credentials or any secret here: those live only in the backend's own .env.

# Base URL of the FastAPI backend (see ..\scholarpath-backend; it runs on port 8001 here).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
