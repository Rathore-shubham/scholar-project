# Copy to `.env` (which Git ignores) and edit. Never commit real values.

# PostgreSQL connection for the app. Create the database and role yourself (see README) and
# put YOUR password here; special characters in it must be URL-encoded (e.g. @ -> %40).
# Leave it empty and the API still starts: /health works, /health/db reports "not_configured".
DATABASE_URL=postgresql+psycopg://scholarpath_app:CHANGE_ME@localhost:5432/scholarpath

# Browser origins allowed to call the API (comma-separated, no wildcard, no trailing path).
# The Next.js dev server runs on http://localhost:3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ENVIRONMENT=development
